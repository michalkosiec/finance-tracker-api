# ENVIRONMENT CONFIGURATION (FINANCE TRACKER)
# Copy this file to .env and update secrets for your environment.

# ---------------------------
# Application / API settings
# ---------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5200
BASE_URL=http://localhost:5200

# ---------------------------
# JWT / Security
# ---------------------------
# The JWT secret must be at least 32 characters for HS256. Keep this secret.
JWT_SECRET=ReplaceWithASecure32+CharMinimumRandomString

# ---------------------------
# Database (Postgres)
# ---------------------------
# If running via Docker Compose the service may expose the DB on localhost:5935
DB_HOST=localhost
DB_PORT=5935
DB_USER=postgres
DB_NAME=finance_db
DB_PASSWORD=ChangeMeToASecurePassword
POSTGRES_IMAGE=postgres:15

# ---------------------------
# Keycloak
# ---------------------------
# Credentials for Keycloak admin user.
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=SecretPassword123!

# ---------------------------
# Notes
# ---------------------------
# - Never commit real secrets to source control. Use environment-specific secret stores for production.
# - When running locally with Docker, copy this file to .env and adjust values as needed.